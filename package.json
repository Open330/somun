{
  "name": "somun",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "소문 — PR for developers who'd rather build than announce.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx --env-file-if-exists=.env watch src/server/main.ts\" \"vite\"",
    "dev:server": "tsx --env-file-if-exists=.env watch src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/src/server/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "omp-sync": "tsx scripts/omp-sync.ts",
    "agent-worker": "tsx scripts/agent-worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.4.0",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "jose": "^6.1.0",
    "pino": "^9.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
