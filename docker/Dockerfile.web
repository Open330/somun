# 소문 웹 정적 빌드 → nginx. VITE_* 값은 빌드 시점에 번들에 박힌다.
#   docker build -f docker/Dockerfile.web \
#     --build-arg VITE_CONVEX_URL=https://somun-api.jiun.dev \
#     --build-arg VITE_AUTH_URL=https://api.jiun.dev -t somun-web .
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_CONVEX_URL
ARG VITE_AUTH_URL
ARG VITE_AUTH_AUDIENCE=somun
ENV VITE_CONVEX_URL=${VITE_CONVEX_URL} VITE_AUTH_URL=${VITE_AUTH_URL} VITE_AUTH_AUDIENCE=${VITE_AUTH_AUDIENCE}
RUN npx vite build

FROM nginx:1.27-alpine
COPY docker/nginx.default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
