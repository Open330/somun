# 서버
PORT=8790
DATA_DIR=./data                 # SQLite 파일 위치 (somun.db)
LOG_LEVEL=info

# 인증. 셋 중 하나:
#  1) 로컬 개발: SOMUN_ALLOW_ANONYMOUS=true
#  2) 단일 사용자: SOMUN_TOKEN=긴-비밀문자열  (Authorization: Bearer)
#  3) jiun-api: AUTH_ISSUER=https://api.jiun.dev AUTH_JWKS_URL=https://api.jiun.dev/.well-known/jwks.json AUTH_AUDIENCE=somun
SOMUN_ALLOW_ANONYMOUS=true

# 수집·LLM
GITHUB_TOKEN=
GEMINI_API_KEYS={"free-1":"..."}   # 라벨 붙은 JSON 맵. paid-* 는 순환하지 않음
CRON=0 0 * * *                     # UTC. 기본 매일 09:00 KST

# 웹 (빌드 시)
VITE_AUTH_URL=                     # jiun-api OAuth 화면. 없으면 로그인 UI 숨김
VITE_AUTH_AUDIENCE=somun
