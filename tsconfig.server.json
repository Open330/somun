{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "outDir": "dist/server",
    "rootDir": ".",
    "noEmit": false,
    "sourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/server",
    "src/app",
    "src/infra",
    "src/core",
    "src/shared",
    "src/video",
    "scripts",
    "src/experiments"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
